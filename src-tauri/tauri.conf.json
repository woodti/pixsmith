{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "PixSmith",
  "version": "0.1.0",
  "identifier": "cn.wooddata.pixsmith",
  "build": {
    "frontendDist": "../dist-desktop",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build:desktop"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "图匠 PixSmith",
        "width": 1280,
        "height": 840,
        "minWidth": 900,
        "minHeight": 600,
        "center": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null,
      "headers": {
        "Cross-Origin-Opener-Policy": "same-origin",
        "Cross-Origin-Embedder-Policy": "require-corp"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.png",
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "woodti",
    "category": "Photography",
    "shortDescription": "离线 AI 图片工具箱",
    "longDescription": "抠图、证件照、AI 消除、变清晰。所有 AI 模型都在本机运行，不联网、不上传。",
    "copyright": "MIT",
    "homepage": "https://github.com/woodti/pixsmith",
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "languages": [
          "SimpChinese",
          "English"
        ],
        "displayLanguageSelector": false
      }
    },
    "macOS": {
      "minimumSystemVersion": "12.0"
    },
    "resources": {
      "../public/models/": "models/"
    }
  },
  "mainBinaryName": "pixsmith"
}